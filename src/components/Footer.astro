---
import ProfileLinks from './ProfileLinks.astro';
import { copy, site } from '@/data/site';
import { pick, to, type Lang } from '@/i18n';
const { lang, home } = Astro.props as { lang: Lang; home: boolean };
---
<footer class="site-footer wrap">
  <div class="footer-main">
    <div>
      <h2>{pick(copy.contact.title, lang)}</h2>
      <a class="email" href={'mailto:' + site.email}>{site.email} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-links">
      <ProfileLinks lang={lang} />
      <p class="muted">{pick(site.motto, lang)}</p>
    </div>
  </div>
  <div class="footer-end">
    <span>© {new Date().getFullYear()} {lang === 'en' ? site.shortName : site.nameZh}</span>
    <a class="quiet-link" href={to('/privacy/', lang)}>{lang === 'en' ? 'Privacy' : '隐私说明'}</a>
    <a class="quiet-link" href={to('/image-credits/', lang)}>{lang === 'en' ? 'Image credits' : '图片来源'}</a>
    {home && lang === 'en' && <a class="counter" href="https://hits.sh/robbierao.github.io/" aria-label="Homepage view statistics">
      <img src="https://hits.sh/robbierao.github.io.svg?style=flat-square&amp;label=Homepage%20views&amp;color=697179&amp;labelColor=697179" width="123" height="20" alt="Homepage views" loading="eager" decoding="async" referrerpolicy="no-referrer" />
    </a>}
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--section); border-top: 1px solid var(--line); padding-block: clamp(2rem, 6vw, 4.5rem) 1.3rem; }
  .footer-main { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: end; }
  .footer-main h2 { font-size: clamp(2rem, 5vw, 3.6rem); letter-spacing: -.03em; margin-bottom: .5rem; }
  :global(html:lang(zh-Hans)) .footer-main h2 { letter-spacing: 0; font-size: clamp(2.2rem, 6vw, 4.4rem); }
  .email { font: 500 clamp(1.1rem, 2vw, 1.4rem) / 1.3 var(--display); text-decoration-color: var(--line); overflow-wrap: anywhere; }
  .footer-links { font-size: .94rem; }
  .footer-links p { margin-top: .6rem; }
  .footer-end { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; align-items: center; border-top: 1px solid var(--line); margin-top: 2.2rem; padding-top: 1rem; font-size: .84rem; color: var(--muted); }
  .counter { margin-inline-start: auto; }
  .counter img { border-radius: 0; width: auto; height: 20px; }
  @media (max-width: 630px) {
    .footer-main { grid-template-columns: minmax(0, 1fr); }
    .counter { margin-inline-start: 0; }
  }
</style>
