---
import type { Lang } from '@/i18n';
const { lang } = Astro.props as { lang: Lang };
const label = lang === 'en' ? 'Enlarged image' : '放大图片';
---
<dialog class="lightbox" data-lightbox aria-label={label}>
  <form method="dialog"><button type="submit" autofocus>{lang === 'en' ? 'Close' : '关闭'} <span aria-hidden="true">×</span></button></form>
  <figure><img alt="" width="1" height="1" /><figcaption></figcaption></figure>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const main = document.querySelector('main');
  if (dialog && main && typeof dialog.showModal === 'function') {
    const image = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    let trigger: HTMLAnchorElement | undefined;
    main.addEventListener('click', event => {
      const target = event.target;
      if (!(event instanceof MouseEvent) || !(target instanceof Element) ||
        event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const anchor = target.closest<HTMLAnchorElement>('figure a[href]');
      const original = anchor?.querySelector('img');
      if (!anchor || !original || !/\.(avif|gif|jpe?g|png|svg|webp)$/i.test(new URL(anchor.href).pathname)) return;
      event.preventDefault();
      trigger = anchor;
      image.alt = original.alt;
      image.width = original.width;
      image.height = original.height;
      image.src = anchor.href;
      caption.textContent = anchor.closest('figure')?.querySelector('figcaption')?.textContent || original.alt;
      dialog.showModal();
    });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      trigger?.focus();
    });
  }
</script>
<style>
  .lightbox { width: min(92vw, 78rem); max-height: 92vh; border: 1px solid var(--line); padding: 1rem; background: var(--surface); color: var(--ink); }
  .lightbox::backdrop { background: rgb(0 0 0 / .74); }
  form { display: flex; justify-content: flex-end; margin-bottom: .7rem; }
  button { background: none; border: 1px solid var(--line); min-height: 44px; padding: .25rem .65rem; }
  img { width: auto; max-height: 72vh; object-fit: contain; margin-inline: auto; }
  figcaption { margin-top: .6rem; font-size: .88rem; color: var(--muted); }
</style>
