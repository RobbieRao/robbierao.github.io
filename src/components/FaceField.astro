---
// The portrait, redrawn as horizontal scan lines whose weight is luminance.
// Around the pointer the same lines are read as relief instead.
import { resolve } from 'node:path';
import sharp from 'sharp';
import type { Lang } from '@/i18n';

const { lang } = Astro.props as { lang: Lang };
const COLS = 84;
const ROWS = 105;
// Head-and-shoulders crop of the 1254px portrait, reduced to a small luminance map.
const map = await sharp(resolve('src/assets/portrait.png'))
  .removeAlpha()
  .extract({ left: 455, top: 235, width: 350, height: 437 })
  .resize(COLS, ROWS)
  .toColourspace('b-w')
  .normalise()
  .raw()
  .toBuffer();
if (map.length !== COLS * ROWS) throw new Error('Portrait map has an unexpected size: ' + map.length);
const label = lang === 'en'
  ? 'Portrait of Robbie Fenggui Rao drawn as horizontal scan lines'
  : '由水平扫描线绘成的饶柏肖像';
---
<div class="face" data-face data-cols={COLS} data-rows={ROWS} data-map={map.toString('base64')}>
  <canvas role="img" aria-label={label}></canvas>
</div>
<noscript><style is:inline>.hero-instrument { display: none; }</style></noscript>

<script>
  const host = document.querySelector<HTMLElement>('[data-face]');
  const canvas = host?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');

  if (host && canvas && ctx) {
    const cols = Number(host.dataset.cols);
    const rows = Number(host.dataset.rows);
    const tones = Uint8Array.from(atob(host.dataset.map ?? ''), char => char.charCodeAt(0));
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const LINES = 62;
    let w = 0, h = 0, ink = '', paper = '', accent = '', dark = false;
    let lensX = 0, lensY = 0, targetX = 0, targetY = 0, lens = 0;
    let hovering = false, onScreen = false, frame = 0, then = 0, clock = 0;

    // Bilinear luminance from 0 (black) to 1 (white).
    const tone = (u: number, v: number) => {
      const x = Math.min(cols - 1, Math.max(0, u * (cols - 1)));
      const y = Math.min(rows - 1, Math.max(0, v * (rows - 1)));
      const x0 = Math.floor(x), y0 = Math.floor(y);
      const x1 = Math.min(cols - 1, x0 + 1), y1 = Math.min(rows - 1, y0 + 1);
      const fx = x - x0, fy = y - y0;
      const top = tones[y0 * cols + x0] * (1 - fx) + tones[y0 * cols + x1] * fx;
      const bottom = tones[y1 * cols + x0] * (1 - fx) + tones[y1 * cols + x1] * fx;
      return (top * (1 - fy) + bottom * fy) / 255;
    };

    function colours() {
      const style = getComputedStyle(host!);
      ink = style.color;
      paper = style.getPropertyValue('--paper').trim();
      accent = style.getPropertyValue('--accent').trim();
      dark = parseInt(paper.slice(1, 3), 16) < 128;
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      // The map is 4:5; a shorter canvas shows the top of it.
      const span = Math.min(1, (h / w) / (rows / cols));
      const count = Math.max(24, Math.round(LINES * span));
      const gap = h / count;
      const step = Math.max(2.5, w / 160);
      const radius = Math.min(w, h) * 0.36;

      for (let i = 0; i < count; i++) {
        const base = (i + 0.5) * gap;
        const v = ((i + 0.5) / count) * span;
        const xs: number[] = [], ys: number[] = [], halves: number[] = [];
        for (let x = 0; x < w + step; x += step) {
          const cx = Math.min(x, w);
          const light = tone(cx / w, v);
          const weight = Math.pow(dark ? light : 1 - light, 2);
          const reach = Math.max(0, 1 - Math.hypot(cx - lensX, base - lensY) / radius);
          const k = lens * reach * reach * (3 - 2 * reach);
          xs.push(cx);
          ys.push(base - k * weight * gap * 3.2);
          halves.push(0.32 + weight * gap * 0.46 * (1 - k * 0.86));
        }
        const n = xs.length;
        if (lens > 0.01) {
          // A lifted ridge hides the lines behind it.
          ctx!.beginPath();
          ctx!.moveTo(xs[0], base);
          for (let j = 0; j < n; j++) ctx!.lineTo(xs[j], ys[j]);
          ctx!.lineTo(xs[n - 1], base);
          ctx!.closePath();
          ctx!.fillStyle = paper;
          ctx!.fill();
        }
        ctx!.beginPath();
        ctx!.moveTo(xs[0], ys[0] - halves[0]);
        for (let j = 1; j < n; j++) ctx!.lineTo(xs[j], ys[j] - halves[j]);
        for (let j = n - 1; j >= 0; j--) ctx!.lineTo(xs[j], ys[j] + halves[j]);
        ctx!.closePath();
        ctx!.fillStyle = ink;
        ctx!.fill();
      }
      if (!still.matches) {
        ctx!.fillStyle = accent;
        ctx!.fillRect(0, ((clock / 9) % 1) * h, w, 1);
      }
    }

    function resize() {
      const box = host!.getBoundingClientRect();
      const ratio = Math.min(devicePixelRatio || 1, 2);
      w = box.width;
      h = box.height;
      canvas!.width = Math.round(w * ratio);
      canvas!.height = Math.round(h * ratio);
      ctx!.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (!hovering) {
        lensX = targetX = w * 0.5;
        lensY = targetY = h * 0.36;
      }
      draw();
    }

    function tick(now: number) {
      const dt = Math.min(0.05, (now - then) / 1000);
      then = now;
      clock += dt;
      const ease = 1 - Math.exp(-dt * 7);
      lensX += (targetX - lensX) * ease;
      lensY += (targetY - lensY) * ease;
      // The relief lens exists only under the pointer; at rest the portrait stays legible.
      lens += ((hovering ? 1 : 0) - lens) * (1 - Math.exp(-dt * 5));
      draw();
      frame = requestAnimationFrame(tick);
    }
    const stop = () => { cancelAnimationFrame(frame); frame = 0; };
    const start = () => {
      if (frame || !onScreen || document.hidden || still.matches) return;
      then = performance.now();
      frame = requestAnimationFrame(tick);
    };

    host.addEventListener('pointermove', event => {
      const box = host.getBoundingClientRect();
      hovering = true;
      targetX = event.clientX - box.left;
      targetY = event.clientY - box.top;
      if (still.matches) {
        // No autonomous motion: the lens appears only where the reader puts it.
        lens = 1; lensX = targetX; lensY = targetY;
        draw();
      }
    });
    host.addEventListener('pointerleave', () => {
      hovering = false;
      if (still.matches) { lens = 0; draw(); }
    });

    const repaint = () => { colours(); draw(); };
    new MutationObserver(repaint).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', repaint);
    still.addEventListener('change', () => { stop(); lens = 0; draw(); start(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) start(); else stop();
    }).observe(host);
    new ResizeObserver(resize).observe(host);

    colours();
    resize();
    host.dataset.ready = '';
  }
</script>

<style>
  .face { aspect-ratio: 4 / 5; color: var(--ink); cursor: crosshair; touch-action: pan-y; }
  canvas { width: 100%; height: 100%; }
  @media (max-width: 650px) {
    .face { aspect-ratio: 1 / 1; }
  }
</style>
